<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.pounceandmiss.Quack</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>quackchat</name>
  <summary>An XMPP chat client</summary>

  <description>
    <p>
      A Qt Quick chat client for XMPP, with OMEMO encryption, group chats,
      file sharing and voice calls. The protocol work is tacky's, linked in
      as a library, so one process is the whole application.
    </p>
  </description>

  <launchable type="desktop-id">io.github.pounceandmiss.Quack.desktop</launchable>

  <url type="homepage">https://github.com/pounceandmiss/quack_qml</url>
  <url type="bugtracker">https://github.com/pounceandmiss/quack_qml/issues</url>

  <keywords>
    <keyword>XMPP</keyword>
    <keyword>Jabber</keyword>
    <keyword>chat</keyword>
    <keyword>messaging</keyword>
    <keyword>OMEMO</keyword>
  </keywords>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
  </content_rating>

  <developer id="io.github.pounceandmiss">
    <name>pounceandmiss</name>
  </developer>

  <releases>
    <release version="0.1.0" date="2026-08-19">
      <description>
        <p>
          First release. Sign in to an existing account or sign up for a new
          one, with one-to-one and group chats, OMEMO encryption, file sharing
          and voice calls.
        </p>
      </description>
    </release>
    <release version="0.0.0" date="2026-08-15">
      <description>
        <p>Pre-alpha. Initial Flatpak packaging.</p>
      </description>
    </release>
  </releases>
</component>
